{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "prefix": "docs",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "dependsOn": [{ "projects": ["tokens"], "target": "build" }],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": { "base": "dist/apps/docs" },
        "browser": "apps/docs/src/main.ts",
        "index": "apps/docs/src/index.html",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/docs/public" }],
        "styles": ["apps/docs/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "600kb", "maximumError": "1mb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "dependsOn": [{ "projects": ["tokens"], "target": "build" }],
      "defaultConfiguration": "development",
      "options": { "port": 5300 },
      "configurations": {
        "production": { "buildTarget": "docs:build:production" },
        "development": { "buildTarget": "docs:build:development" }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [{ "projects": ["tokens", "ui"], "target": "build" }],
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
      }
    },
    "stylelint": {
      "command": "stylelint \"src/**/*.css\"",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.css",
        "{workspaceRoot}/stylelint.config.mjs",
        "{workspaceRoot}/packages/lint/src/stylelint/**/*",
        { "externalDependencies": ["stylelint"] }
      ],
      "dependsOn": [{ "projects": ["lint"], "target": "build" }]
    }
  }
}
