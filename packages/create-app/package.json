{
  "name": "@openstuff-dev/create-app",
  "version": "0.1.3",
  "type": "module",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/create-app/dist",
          "main": "packages/create-app/bin/index.ts",
          "tsConfig": "packages/create-app/tsconfig.lib.json",
          "generatePackageJson": false
        }
      }
    },
    "tags": [
      "type:package"
    ],
    "sourceRoot": "packages/create-app/bin"
  },
  "dependencies": {
    "@openstuff-dev/nx": "0.2.2",
    "create-nx-workspace": "24.0.0",
    "tslib": "^2.3.0"
  },
  "bin": {
    "create-app": "dist/bin/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstuff-dev/design.git",
    "directory": "packages/create-app"
  },
  "license": "MIT"
}
