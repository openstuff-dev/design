{
  "name": "@openstuff-dev/server",
  "version": "0.3.1",
  "description": "Server building blocks shared by OpenStuff apps: a guarded fetch, encrypted storage for integration keys and the server-wide integration routes",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@openstuff-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "name": "server",
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstuff-dev/design.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "devDependencies": {
    "fastify": "^5.12.8"
  },
  "peerDependencies": {
    "fastify": "^5.12.7"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
