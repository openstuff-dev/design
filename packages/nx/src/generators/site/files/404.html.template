<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Page not found · <%= name %></title>
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="dark light">
  <!-- GitHub Pages serves this file for every missing path, so all URLs are absolute from the site root. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="os-site">
<header class="os-topbar">
  <div class="os-wrap">
    <a class="os-brand" href="/" aria-label="<%= name %> home">
      <svg class="os-mark" aria-hidden="true"><use href="/assets/logo.svg#mark-<%= slug %>"/></svg>
      <span class="os-wordmark" aria-hidden="true"><%= open %><b><%= rest %></b></span>
    </a>
  </div>
</header>
<main class="os-not-found">
  <div class="os-wrap">
    <p class="os-not-found-code">404 · nothing here</p>
    <h1>This page doesn't exist.</h1>
    <p>The link may be old, or the address has a typo.</p>
    <div class="os-cta-row">
      <a class="os-button" data-variant="primary" data-size="lg" href="/">Go to the home page</a>
      <a class="os-button" data-size="lg" href="<%= repository %>">GitHub</a>
    </div>
  </div>
</main>
</body>
</html>
