name: Pages

# Publishes <%= root %>/ to GitHub Pages. Set the custom domain in Settings → Pages: deploys through
# Actions ignore a CNAME file.
on:
  push:
    branches: [main, master]
    paths: ['<%= root %>/**', '.github/workflows/pages.yml']
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v5
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v4
        with:
          path: <%= root %>
      - id: deployment
        uses: actions/deploy-pages@v4
