{
  "name": "@openstuff-dev/nx",
  "version": "0.1.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@openstuff-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "nx": {
    "name": "nx",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/nx/dist",
          "main": "packages/nx/src/index.ts",
          "tsConfig": "packages/nx/tsconfig.lib.json",
          "rootDir": "packages/nx/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/nx/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/nx/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    },
    "tags": [
      "type:package"
    ]
  },
  "dependencies": {
    "@nx/devkit": "24.0.0",
    "tslib": "^2.3.0"
  },
  "generators": "./generators.json",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openstuff-dev/design.git",
    "directory": "packages/nx"
  },
  "license": "MIT"
}
